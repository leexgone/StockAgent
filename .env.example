# 子木容器凭据模板（ADR-0018 D8）：cp .env.example .env 后填值。
# 单通道纪律：凭据只放这里（compose env_file 注入容器 env，config.toml ${VAR} 占位展开消费）；
# 勿在卷内 /data/.robit/ 放 .env——robit 的 .env 加载会无条件覆盖容器 env，双通道真相不可预测。
# 本文件空占位入库；真实 .env 已被 gitignore，永不提交/上传/进镜像。

# 对话模型（通义千问，OpenAI 兼容面）——Agent 在线必需
DASHSCOPE_API_KEY=
# 生图模型（通义万相）——generate_image 工具必需
BAILIAN_API_KEY=
# QQ 机器人凭据——启用 QQ 通道才需要（config [zimu.channels] qq=true）
ZIMU_QQ_APP_ID=
ZIMU_QQ_APP_SECRET=
# 微信无需 env：bot_token 由扫码登录落卷内 state 文件（docs/08 §3）

# 可选：停用调度器（设任意值即停用；去掉本行恢复）
# ZIMU_SCHEDULER_DISABLE=1