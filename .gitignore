# ── 系统与编辑器 ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ── 依赖与构建产物（后续接行情/模型时用得到）──
node_modules/
dist/
build/
target/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── 本地密钥：微信 AppID / Token / Webhook、行情源 key 一律不要提交 ──
.env
.env.*
!.env.example
*.local
secrets.*
config.local.*

# ── 数据导出与缓存（券商对账单、行情快照等）──
*.csv
*.sqlite
*.sqlite3
*.db
# SQLite WAL/日志边车：checkpoint 前含与 .db 同级的真实数据，同样永不入库
*.db-shm
*.db-wal
*.db-journal
*.sqlite-shm
*.sqlite-wal
exports/
data/cache/
cache/

# ── 工具与临时目录 ────────────────────────────
.file-versions/
.od/
# robit 运行时会话库与记忆文件（<workdir>/.robit/memory/robit.db 等），永不入库。
# 2026-11-07 配置分层：工程本地 robit 配置 = backend/.robit/config.toml——虽只含
# ${VAR} 占位引用，按用户拍板**同样不入库**（机器本地文件），整目录忽略保持不变。
.robit/
screenshots/
shots/
*.log

# ── Claude Code：本机设置含个人路径与权限，不提交（CLAUDE.md 要提交）──
.claude/settings.local.json
.claude/*.local.json
