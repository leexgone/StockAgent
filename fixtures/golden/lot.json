{
  "group": "lot",
  "title": "标的属性与交易单位",
  "spec": "docs/03-domain-rules.md §1",
  "schema_version": 1,
  "status": "active",
  "tolerance": 1e-9,
  "notes": "错误文案不进 fixture，只断言 reason 枚举码（not_lot_multiple / exceeds_held），文案是界面层职责。B12 已定稿（2026-10-30）：卖出 qty == held 豁免整手校验（A 股奇零股须一次性卖出），部分卖出仍须整手倍数；判定顺序 ①qty<0 ②qty==0 未填写 ③清仓豁免 ④整手 ⑤超持仓。",
  "cases": [
    {
      "id": "lot-stock",
      "fn": "lot_size",
      "desc": "股票 1 手 = 100 股",
      "tags": ["normal"],
      "input": { "kind": "stock" },
      "expect": { "lot": 100 }
    },
    {
      "id": "lot-etf",
      "fn": "lot_size",
      "desc": "ETF 1 手 = 100 份",
      "tags": ["normal"],
      "input": { "kind": "etf" },
      "expect": { "lot": 100 }
    },
    {
      "id": "lot-cb",
      "fn": "lot_size",
      "desc": "可转债 1 手 = 10 张",
      "tags": ["normal"],
      "input": { "kind": "cb" },
      "expect": { "lot": 10 }
    },
    {
      "id": "dec-stock",
      "fn": "price_decimals",
      "desc": "股票报价 2 位小数",
      "tags": ["normal"],
      "input": { "kind": "stock" },
      "expect": { "decimals": 2 }
    },
    {
      "id": "dec-etf",
      "fn": "price_decimals",
      "desc": "ETF 报价 3 位小数",
      "tags": ["normal"],
      "input": { "kind": "etf" },
      "expect": { "decimals": 3 }
    },
    {
      "id": "dec-cb",
      "fn": "price_decimals",
      "desc": "转债报价 3 位小数（§1 表格即定稿口径；抽屉显示 2 位的 bug 由 B4/P1-T3 修）",
      "tags": ["normal"],
      "input": { "kind": "cb" },
      "expect": { "decimals": 3 }
    },
    {
      "id": "vq-buy-ok",
      "fn": "validate_qty",
      "desc": "买 300 股，为 100 的整数倍 → 合法",
      "tags": ["normal"],
      "input": { "kind": "stock", "side": "buy", "qty": 300, "held": 0 },
      "expect": { "valid": true, "reason": null }
    },
    {
      "id": "vq-buy-not-lot",
      "fn": "validate_qty",
      "desc": "买 250 股，250 % 100 = 50 ≠ 0 → 拒绝",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "buy", "qty": 250, "held": 0 },
      "expect": { "valid": false, "reason": "not_lot_multiple" }
    },
    {
      "id": "vq-cb-not-lot",
      "fn": "validate_qty",
      "desc": "买 25 张转债，25 % 10 = 5 ≠ 0 → 拒绝",
      "tags": ["boundary"],
      "input": { "kind": "cb", "side": "buy", "qty": 25, "held": 0 },
      "expect": { "valid": false, "reason": "not_lot_multiple" }
    },
    {
      "id": "vq-sell-over",
      "fn": "validate_qty",
      "desc": "卖 300 但持仓 200 → 拒绝（reason 报超出持仓）",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "sell", "qty": 300, "held": 200 },
      "expect": { "valid": false, "reason": "exceeds_held" }
    },
    {
      "id": "vq-sell-full",
      "fn": "validate_qty",
      "desc": "卖出全部持仓 200 = held → 合法（清仓）",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "sell", "qty": 200, "held": 200 },
      "expect": { "valid": true, "reason": null }
    },
    {
      "id": "vq-sell-odd-lot",
      "fn": "validate_qty",
      "desc": "卖 150 股（奇零股）且 = held：清仓豁免整手校验 → 合法（B12 定稿 2026-10-30，A 股奇零股须一次性卖出；送股后 150 股可整笔清仓）",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "sell", "qty": 150, "held": 150 },
      "expect": { "valid": true, "reason": null }
    },
    {
      "id": "vq-sell-odd-partial",
      "fn": "validate_qty",
      "desc": "持 150 股卖 50：既非整手倍数也非清仓（豁免只认 qty == held）→ 拒绝，奇零股不可拆着卖",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "sell", "qty": 50, "held": 150 },
      "expect": { "valid": false, "reason": "not_lot_multiple" }
    },
    {
      "id": "vq-sell-lot-leaves-odd",
      "fn": "validate_qty",
      "desc": "持 150 股卖 100（整手倍数、≤ held）→ 合法；剩余 50 股奇零留待下次一次性清仓",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "sell", "qty": 100, "held": 150 },
      "expect": { "valid": true, "reason": null }
    },
    {
      "id": "vq-sell-over-odd",
      "fn": "validate_qty",
      "desc": "持 150 股卖 250：非清仓（250 ≠ 150）且 250 % 100 ≠ 0 → 整手校验（序④）先于超持仓校验（序⑤）报 not_lot_multiple——判定顺序本身是口径的一部分",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "sell", "qty": 250, "held": 150 },
      "expect": { "valid": false, "reason": "not_lot_multiple" }
    },
    {
      "id": "vq-cb-sell-odd-full",
      "fn": "validate_qty",
      "desc": "转债奇零 15 张全部卖出（15 % 10 ≠ 0 但 = held）→ 清仓豁免合法（豁免按 kind 无差别适用）",
      "tags": ["boundary"],
      "input": { "kind": "cb", "side": "sell", "qty": 15, "held": 15 },
      "expect": { "valid": true, "reason": null }
    },
    {
      "id": "qt-held-normal",
      "fn": "quick_tiers",
      "desc": "持仓 1250 股卖出：base = max(100, 1250) = 1250；10% = 125 → floor(125/100)×100 = 100；25% = 312.5 → floor(312.5/100)×100 = 300；50% = 625 → floor(625/100)×100 = 600；卖出追加「全部清仓」= held",
      "tags": ["normal"],
      "input": { "kind": "stock", "side": "sell", "held": 1250 },
      "expect": { "tiers": [100, 300, 600, 1250] }
    },
    {
      "id": "qt-empty",
      "fn": "quick_tiers",
      "desc": "空持仓买入：base = 10 手 = 1000；10% = 100 → 100；25% = 250 → floor(250/100)×100 = 200；50% = 500 → 500；买入无清仓档",
      "tags": ["empty"],
      "input": { "kind": "stock", "side": "buy", "held": 0 },
      "expect": { "tiers": [100, 200, 500] }
    },
    {
      "id": "qt-odd-held",
      "fn": "quick_tiers",
      "desc": "持仓 90 股（不足一手）：base = max(100, 90) = 100；三档 floor 后均为 0，按「每档至少一手」回落到 100",
      "tags": ["boundary"],
      "input": { "kind": "stock", "side": "buy", "held": 90 },
      "expect": { "tiers": [100, 100, 100] }
    },
    {
      "id": "qt-cb",
      "fn": "quick_tiers",
      "desc": "持有 30 张转债卖出：base = 30；10% = 3 → floor(3/10)×10 = 0 → 回落 10；25% = 7.5 → 0 → 10；50% = 15 → floor(15/10)×10 = 10；追加清仓 30",
      "tags": ["boundary"],
      "input": { "kind": "cb", "side": "sell", "held": 30 },
      "expect": { "tiers": [10, 10, 10, 30] }
    }
  ]
}
