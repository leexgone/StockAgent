{
  "group": "vol_synth",
  "title": "波动合成假设",
  "spec": "docs/03-domain-rules.md §8",
  "schema_version": 1,
  "status": "active",
  "tolerance": 1e-5,
  "notes": "ann_vol = √(ΣᵢΣⱼ wᵢwⱼσᵢσⱼρᵢⱼ) × √244 × 100（输出为百分数，与 diagnosis.html portVol 一致）。w 为占市值权重（分数，Σw 不强制为 1——再平衡清单的「调整后」场景权重和小于 1）；σ 为日收益标准差（分数）。ρᵢⱼ：同标的 1、同行业 0.62、跨行业 0.35（写死假设值，C7 拍板改估计值后本组 fixture 要跟着改）。",
  "cases": [
    {
      "id": "vs-single",
      "fn": "vol_synth",
      "desc": "单标的：方差 = 1×1×0.01×0.01×1 = 0.0001 → √ = 0.01；ann_vol = 0.01×√244×100 = √244 ≈ 15.620499",
      "tags": ["boundary"],
      "input": { "items": [{ "code": "A", "sector": "X", "w": 1.0, "sigma": 0.01 }] },
      "expect": { "ann_vol": 15.620499 }
    },
    {
      "id": "vs-two-same-sector",
      "fn": "vol_synth",
      "desc": "两标的同行业（ρ=0.62）：对角 2×(0.5²×0.02²×1) = 2×0.0001 = 0.0002；交叉 2×(0.5×0.5×0.02×0.02×0.62) = 2×0.000062 = 0.000124；方差 = 0.000324 → √ = 0.018（精确）；ann_vol = 0.018×√244×100 = 1.8×√244 ≈ 28.116899",
      "tags": ["normal"],
      "input": {
        "items": [
          { "code": "A", "sector": "医药", "w": 0.5, "sigma": 0.02 },
          { "code": "B", "sector": "医药", "w": 0.5, "sigma": 0.02 }
        ]
      },
      "expect": { "ann_vol": 28.116899 }
    },
    {
      "id": "vs-two-cross-sector",
      "fn": "vol_synth",
      "desc": "两标的跨行业（ρ=0.35）：对角 0.6²×0.02² + 0.4²×0.01² = 0.000144 + 0.000016 = 0.00016；交叉 2×(0.6×0.4×0.02×0.01×0.35) = 0.0000336；方差 = 0.0001936 → √ = 0.013914022（√1936 = 44 精确 → 44×10^−3.5）；ann_vol ≈ 21.734398",
      "tags": ["normal"],
      "input": {
        "items": [
          { "code": "A", "sector": "医药", "w": 0.6, "sigma": 0.02 },
          { "code": "B", "sector": "宽基", "w": 0.4, "sigma": 0.01 }
        ]
      },
      "expect": { "ann_vol": 21.734398 }
    },
    {
      "id": "vs-three-mixed",
      "fn": "vol_synth",
      "desc": "三标混合 ρ 矩阵（A/B 同行业 0.62，A/C、B/C 跨行业 0.35，对角 1）：对角 0.5²×0.02² + 0.25²×0.01² + 0.25²×0.02² = 0.0001 + 0.00000625 + 0.000025 = 0.00013125；AB 2×(0.5×0.25×0.02×0.01×0.62) = 0.000031；AC 2×(0.5×0.25×0.02×0.02×0.35) = 0.000035；BC 2×(0.25×0.25×0.01×0.02×0.35) = 0.00000875；方差 = 0.000206 → √ ≈ 0.0143527；ann_vol ≈ 22.419634",
      "tags": ["boundary"],
      "tolerance": 1e-4,
      "input": {
        "items": [
          { "code": "A", "sector": "医药", "w": 0.5, "sigma": 0.02 },
          { "code": "B", "sector": "医药", "w": 0.25, "sigma": 0.01 },
          { "code": "C", "sector": "有色", "w": 0.25, "sigma": 0.02 }
        ]
      },
      "expect": { "ann_vol": 22.419634 }
    },
    {
      "id": "vs-empty",
      "fn": "vol_synth",
      "desc": "空持仓：方差 = 0 → ann_vol = 0（不得 NaN）",
      "tags": ["empty"],
      "input": { "items": [] },
      "expect": { "ann_vol": 0.0 }
    },
    {
      "id": "vs-empty-sector",
      "fn": "vol_synth",
      "desc": "两空串标的视为同行业（ρ=0.62，空串==空串，P7-T6/ADR-0016 口径钉死）：与 vs-two-same-sector 同数——对角 2×(0.5²×0.02²)=0.0002、交叉 2×(0.5×0.5×0.02×0.02×0.62)=0.000124、方差 0.000324 → √=0.018；ann_vol=1.8×√244≈28.116899。空串互 ρ=0.62 是保守假设",
      "tags": ["boundary"],
      "input": {
        "items": [
          { "code": "A", "sector": "", "w": 0.5, "sigma": 0.02 },
          { "code": "B", "sector": "", "w": 0.5, "sigma": 0.02 }
        ]
      },
      "expect": { "ann_vol": 28.116899 }
    }
  ]
}
