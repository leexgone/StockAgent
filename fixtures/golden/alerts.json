{
  "group": "alerts",
  "title": "预警判定（生产口径，调度引擎的规则函数侧）",
  "spec": "docs/03-domain-rules.md §12",
  "schema_version": 1,
  "status": "active",
  "tolerance": 1e-9,
  "notes": "eval_alerts 无状态纯函数：逐持仓输入事实（行情/成本/最近留档 stop+target_hi/日线量能/转债强赎字段）→ 按固定判定序输出全部触发的预警 {type,level,text}。type 封闭词汇：触及涨停/触及跌停/跌破成本/触及止损线/触及止盈线/放量/强赎公告/临近到期；level 词汇（§11）：up/down 只用于价格方向、warn 要动作类，引擎不产出 flat。text 是展示层模板（比对规则 6：expect 未列不校验）。数据缺失 → 对应序不参与判定，不伪造。同日 (code,type) 去重是调度器职责（需要库状态），不在本组。today 为上海日期 YYYY-MM-DD，用于转债期限的自然日差。",
  "cases": [
    {
      "id": "al-limit-up",
      "fn": "eval_alerts",
      "desc": "涨停压线：limit_up = 10.00×1.10 = 11.00（§2 整数单元 half-up，调用方拼装传入），price = 11.0 恰好等于 → 含边界触发。cost/stop/target_hi/量能全缺 → 其余序不参与。",
      "tags": ["boundary"],
      "input": {
        "today": "2026-10-29",
        "item": {
          "kind": "stock", "price": 11.0, "prev": 10.0,
          "limit_up": 11.0, "limit_down": 9.0,
          "cost": null, "stop": null, "target_hi": null,
          "volume_today": null, "vol_hist": [],
          "redeem_status": null, "last_trade_date": null, "maturity_date": null
        }
      },
      "expect": {
        "alerts": [
          { "type": "触及涨停", "level": "up" }
        ]
      }
    },
    {
      "id": "al-limit-down",
      "fn": "eval_alerts",
      "desc": "跌停压线：limit_down = 10.00×0.90 = 9.00，price = 9.0 恰好等于 → 含边界触发，level = down（方向语义，§11）。",
      "tags": ["boundary"],
      "input": {
        "today": "2026-10-29",
        "item": {
          "kind": "stock", "price": 9.0, "prev": 10.0,
          "limit_up": 11.0, "limit_down": 9.0,
          "cost": null, "stop": null, "target_hi": null,
          "volume_today": null, "vol_hist": [],
          "redeem_status": null, "last_trade_date": null, "maturity_date": null
        }
      },
      "expect": {
        "alerts": [
          { "type": "触及跌停", "level": "down" }
        ]
      }
    },
    {
      "id": "al-below-cost-and-stop",
      "fn": "eval_alerts",
      "desc": "同标的双预警按判定序全部产出：price 9.5 < cost 10.0 → 跌破成本（浮亏 (9.5−10)/10×100 = −5.00%）；price 9.5 ≤ stop 9.5 恰好压线含边界 → 触及止损线。序 3 在序 4 前。",
      "tags": ["normal"],
      "input": {
        "today": "2026-10-29",
        "item": {
          "kind": "stock", "price": 9.5, "prev": 10.0,
          "limit_up": 11.0, "limit_down": 9.0,
          "cost": 10.0, "stop": 9.5, "target_hi": null,
          "volume_today": null, "vol_hist": [],
          "redeem_status": null, "last_trade_date": null, "maturity_date": null
        }
      },
      "expect": {
        "alerts": [
          { "type": "跌破成本", "level": "down" },
          { "type": "触及止损线", "level": "down" }
        ]
      }
    },
    {
      "id": "al-cost-line-safe",
      "fn": "eval_alerts",
      "desc": "price = cost = 10.0 相等不算跌破（压线算安全，附录规则 4）→ 无预警。",
      "tags": ["boundary"],
      "input": {
        "today": "2026-10-29",
        "item": {
          "kind": "stock", "price": 10.0, "prev": 10.0,
          "limit_up": 11.0, "limit_down": 9.0,
          "cost": 10.0, "stop": null, "target_hi": null,
          "volume_today": null, "vol_hist": [],
          "redeem_status": null, "last_trade_date": null, "maturity_date": null
        }
      },
      "expect": { "alerts": [] }
    },
    {
      "id": "al-take-profit",
      "fn": "eval_alerts",
      "desc": "price 12.0 ≥ target_hi 12.0 恰好压线含边界 → 触及止盈线；level = warn（要动作的提醒，非方向语义——与原型「止盈提醒」样本一致）。price > stop 9.0 → 序 4 不触发。",
      "tags": ["boundary"],
      "input": {
        "today": "2026-10-29",
        "item": {
          "kind": "stock", "price": 12.0, "prev": 11.0,
          "limit_up": null, "limit_down": null,
          "cost": 10.0, "stop": 9.0, "target_hi": 12.0,
          "volume_today": null, "vol_hist": [],
          "redeem_status": null, "last_trade_date": null, "maturity_date": null
        }
      },
      "expect": {
        "alerts": [
          { "type": "触及止盈线", "level": "warn" }
        ]
      }
    },
    {
      "id": "al-vol-surge-up",
      "fn": "eval_alerts",
      "desc": "放量上涨：vol_hist 20 根含 1 个 null → 有效样本 19 ≥ 5，avg = 38000/19 = 2000；ratio = 5000/2000 = 2.5 ≥ 2.0 → 触发；方向 (10.5−10)/10 = +5% ≥ 0 → level = up。",
      "tags": ["normal"],
      "input": {
        "today": "2026-10-29",
        "item": {
          "kind": "stock", "price": 10.5, "prev": 10.0,
          "limit_up": null, "limit_down": null,
          "cost": null, "stop": null, "target_hi": null,
          "volume_today": 5000, "vol_hist": [2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, 2000, null],
          "redeem_status": null, "last_trade_date": null, "maturity_date": null
        }
      },
      "expect": {
        "alerts": [
          { "type": "放量", "level": "up" }
        ]
      }
    },
    {
      "id": "al-vol-surge-down-at-line",
      "fn": "eval_alerts",
      "desc": "放量下跌压线：avg = 20000/10 = 2000，ratio = 4000/2000 = 2.0 恰好等于阈值 → 含边界触发；方向 (9.8−10)/10 = −2% < 0 → level = down。",
      "tags": ["boundary"],
      "input": {
        "today": "2026-10-29",
        "item": {
