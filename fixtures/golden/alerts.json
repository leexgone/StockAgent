      }
    },
    {
      "id": "al-vol-surge-no-prev",
      "fn": "eval_alerts",
      "desc": "方向不可判：prev 缺失 → 放量仍触发（avg = 5000/5 = 1000，ratio = 5000/1000 = 5.0；有效样本 5 根恰好压线 ≥5 参与）但 level = warn。",
